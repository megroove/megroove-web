# 本番ビルド（npm run deploy）の設定。ここに書くのは公開してよい値だけ（API キー等は Worker の secret にしかない）。
# 豆ラベルの AI 読み取りを出し、送り先（本番の Worker）と Turnstile のサイトキーを決める。
# 読み取りを止めたいときは VITE_AI_SCAN_ENABLED=false にしてデプロイし直す（CSP からも送り先が消える）
VITE_AI_SCAN_ENABLED=true
VITE_LABEL_API_URL=https://megroove-api.megroove-app.workers.dev
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF5lIWOuo3l5AyoC
